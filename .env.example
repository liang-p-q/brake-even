# Copy this file to .env.local (which git ignores) and fill in what you use.
# On Vercel, set the same variables in Project Settings → Environment Variables.

# Required for the AI price check: an MIT Parley API key (sk-parley-v1-...) from platform.parley.mit.edu,
# and Parley's Anthropic-compatible gateway. (With a direct Anthropic key instead, leave the base URL out.)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://parley.api.mit.edu

# Needed in production for a reliable $15/month cap: the shared spend meter. Vercel → Storage →
# Upstash for Redis fills these in (it may name them KV_REST_API_URL / KV_REST_API_TOKEN; both spellings work).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: a lower monthly budget in USD (it can't go above 15). Set to 0 to preview the paused notice.
# PRICE_CHECK_BUDGET_USD=
